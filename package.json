    "build:tsc": "tsc -p tsconfig.prod.json",
    "build:clean": "rimraf dist"
  },
  "dependencies": {
    "@types/compression": "^1.7.0",
    "@types/errorhandler": "^1.5.0",
    "@types/express": "^4.17.13",
    "@types/glob": "^7.2.0",
    "@types/node": "^18.0.0",
    "body-parser": "^1.20.2",
    "bodybuilder": "^2.5.1",
    "bson": "^5.5.0",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.0.0",
    "errorhandler": "^1.5.1",
    "express": "^4.18.2",
    "express-promise-router": "^4.1.0",
    "express-validator": "^7.0.1",
    "glob": "^11.0.1",
    "helmet": "^6.1.2",
    "http-status": "^2.0.0",
    "nunjucks": "^3.2.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "winston": "^3.8.2"
