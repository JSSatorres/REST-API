    "http-status": "^2.0.0",
    "mongodb": "^6.15.0",
    "nunjucks": "^3.2.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "uuid": "^11.1.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.36",
    "@types/cookie-parser": "^1.4.3",
