    "@types/supertest": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "faker": "5.5.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.4.3",
    "prettier": "^3.0.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "{src,tests}/**/*.ts": [
