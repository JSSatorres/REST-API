    "cross-env": "^7.0.3",
    "cypress": "^14.2.0",
    "eslint": "^9.21.0",
    "faker": "5.5.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.0.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "swagger-autogen": "^2.23.7",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "husky": {
    "hooks": {
