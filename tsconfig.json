{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "target": "ES6",
    "noImplicitAny": true,
    "sourceMap": false,
    "rootDir": ".",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
